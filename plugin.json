{
  "name": "apex",
  "displayName": "APEX v2 — Senior Engineering Team",
  "description": "10-agent orchestrator + specialists for any CLI coding agent. 3 MCP servers, Composio (1000+ tools), Mirage VFS (50+ backends), OfficeCLI. Routes: @arch, @ui, @debug, @perf, @sec, @infra, @nova, @reed, @review, @flex.",
  "version": "3.0.0",
  "author": {
    "name": "asno-dev",
    "url": "https://github.com/asno-dev/apex"
  },
  "tags": ["architecture", "design", "debugging", "performance", "security", "infrastructure", "code-review", "research", "mvp", "testing", "deployment", "composio", "mirage", "officecli"],
  "categories": ["workflow", "code-quality", "design", "testing", "deployment", "productivity"],
  "hooks": "./adapters/claude-code/hooks.json",
  "mcpServers": {
    "apex-hands": {
      "type": "local",
      "command": ["node", "src/hands-server.mjs"]
    },
    "mirage-vfs": {
      "type": "local",
      "command": ["node", "src/mirage-server.mjs"]
    },
    "apex-composio": {
      "type": "local",
      "command": ["node", "src/composio-server.mjs"]
    }
  },
  "subagents": ["arch", "ui", "debug", "perf", "sec", "infra", "nova", "reed", "review", "flex"],
  "commands": ["apex", "apex-arch", "apex-ui", "apex-debug", "apex-perf", "apex-sec", "apex-infra", "apex-nova", "apex-reed", "apex-review", "apex-flex", "apex-docs", "apex-excel", "apex-ppt", "apex-composio-setup", "apex-composio-status", "apex-composio-sync", "apex-mirage"],
  "features": {
    "modes": ["direct", "team", "select"],
    "composio": true,
    "mirage": true,
    "officecli": true,
    "agentChains": true,
    "dynamicPeers": true
  }
}
