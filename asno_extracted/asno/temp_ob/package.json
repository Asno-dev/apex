{
  "name": "opencodeagent",
  "version": "2.0.0",
  "description": "OpenCodeAgent — Full-power sandboxed Ubuntu computer for autonomous AI agents",
  "private": true,
  "workspaces": [
    "vibe-coding"
  ],
  "scripts": {
    "dev": "npm run dev --prefix vibe-coding",
    "dev:frontend": "npm run dev --prefix vibe-coding",
    "build": "npm run build --prefix vibe-coding",
    "start": "npm run dev --prefix vibe-coding",
    "lint": "npm run lint --prefix vibe-coding",
    "build:docker": "docker compose build",
    "start:docker": "docker compose up -d",
    "stop:docker": "docker compose down",
    "logs": "docker compose logs -f",
    "clean": "docker compose down -v --rmi all"
  },
  "keywords": [
    "ai-agent",
    "sandbox",
    "ubuntu",
    "computer-use",
    "autonomous"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.10.2",
    "coi-serviceworker": "^0.1.7",
    "mammoth": "^1.12.0",
    "motion": "^12.40.0",
    "playwright": "^1.60.0",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "node-domexception": "file:./packages/node-domexception"
  }
}
