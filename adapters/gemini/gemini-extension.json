{
  "name": "apex",
  "version": "2.0.0",
  "description": "APEX v2 — 10-agent senior engineering team. @arch architect, @ui UI, @debug debug, @perf perf, @sec security, @infra infra, @nova creative, @reed research, @review review, @flex MVP. MCP servers: apex-hands (56 tools), mirage-vfs (50+ backends), apex-composio (1000+ tools). Commands: apex-docs, apex-excel, apex-ppt, apex-composio-setup, apex-composio-status, apex-composio-sync, apex-mirage, /apex-team. Composio integration. OfficeCLI. 3 modes: Direct, Team, Select.",
  "agents": [
    {"name": "arch", "file": "agents/arch.md", "tag": "@arch", "role": "Architect"},
    {"name": "ui", "file": "agents/ui.md", "tag": "@ui", "role": "UI/UX Designer"},
    {"name": "debug", "file": "agents/debug.md", "tag": "@debug", "role": "Debugger"},
    {"name": "perf", "file": "agents/perf.md", "tag": "@perf", "role": "Performance Engineer"},
    {"name": "sec", "file": "agents/sec.md", "tag": "@sec", "role": "Security Engineer"},
    {"name": "infra", "file": "agents/infra.md", "tag": "@infra", "role": "Infrastructure Engineer"},
    {"name": "nova", "file": "agents/nova.md", "tag": "@nova", "role": "Creative Technologist"},
    {"name": "reed", "file": "agents/reed.md", "tag": "@reed", "role": "Researcher"},
    {"name": "review", "file": "agents/review.md", "tag": "@review", "role": "Reviewer"},
    {"name": "flex", "file": "agents/flex.md", "tag": "@flex", "role": "Founder/Product Strategist"}
  ],
  "commands": [
    {"name": "apex", "file": "commands/apex.md"},
    {"name": "apex-docs", "file": "commands/apex-docs.md"},
    {"name": "apex-excel", "file": "commands/apex-excel.md"},
    {"name": "apex-ppt", "file": "commands/apex-ppt.md"},
    {"name": "apex-composio-setup", "file": "commands/apex-composio-setup.md"},
    {"name": "apex-composio-status", "file": "commands/apex-composio-status.md"},
    {"name": "apex-composio-sync", "file": "commands/apex-composio-sync.md"},
    {"name": "apex-mirage", "file": "commands/apex-mirage.md"}
  ],
  "mcpServers": {
    "apex-hands": {
      "type": "local",
      "command": "node src/hands-server.mjs",
      "description": "56 domain tools for all 10 agents"
    },
    "mirage-vfs": {
      "type": "local",
      "command": "node src/mirage-server.mjs",
      "description": "Virtual filesystem across 50+ backends"
    },
    "apex-composio": {
      "type": "local",
      "command": "node src/composio-server.mjs",
      "description": "Bridge to 1000+ external tools via Composio"
    }
  },
  "features": {
    "agents": true,
    "commands": true,
    "mcpServers": true,
    "composio": true,
    "mirage": true,
    "officecli": true,
    "modes": ["direct", "team", "select"],
    "routing": true,
    "dynamicActivation": true,
    "crossDelegation": true
  }
}
