{
  "name": "apex",
  "version": "3.0.0",
  "description": "APEX v2 — 10-agent senior engineering team. Full feature set: 10 specialist agents, 3 MCP servers (56+1000+ tools), Composio integration, Mirage VFS, OfficeCLI.",
  "contextFileName": "AGENTS.md",
  "mcpServers": {
    "apex-hands": {
      "type": "local",
      "command": ["node", "src/hands-server.mjs"]
    },
    "mirage-vfs": {
      "type": "local",
      "command": ["node", "src/mirage-server.mjs"]
    },
    "apex-composio": {
      "type": "local",
      "command": ["node", "src/composio-server.mjs"]
    }
  },
  "agents": ["arch", "ui", "debug", "perf", "sec", "infra", "nova", "reed", "review", "flex"],
  "commands": ["apex", "docs", "excel", "ppt", "composio-setup", "composio-status", "composio-sync", "mirage"],
  "features": {
    "modes": ["direct", "team", "select"],
    "composio": true,
    "mirage": true,
    "officecli": true,
    "agentChains": true,
    "dynamicPeers": true
  }
}
