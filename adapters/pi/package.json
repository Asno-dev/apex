{
  "name": "apex",
  "version": "3.0.0",
  "description": "APEX v2 — 10-agent senior engineering team for Pi agent. 3 MCP servers, Composio, Mirage VFS, OfficeCLI.",
  "mcp": {
    "servers": {
      "apex-hands": {
        "type": "local",
        "command": ["node", "src/hands-server.mjs"]
      },
      "mirage-vfs": {
        "type": "local",
        "command": ["node", "src/mirage-server.mjs"]
      },
      "apex-composio": {
        "type": "local",
        "command": ["node", "src/composio-server.mjs"]
      }
    }
  },
  "agents": ["arch", "ui", "debug", "perf", "sec", "infra", "nova", "reed", "review", "flex"],
  "skills": [
    "apex", "apex-arch", "apex-ui", "apex-debug", "apex-perf",
    "apex-sec", "apex-infra", "apex-nova", "apex-reed", "apex-review", "apex-flex"
  ]
}
